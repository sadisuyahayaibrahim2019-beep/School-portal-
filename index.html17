<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Ummul-Qura School Portal</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/firebase/10.12.2/firebase-app-compat.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/firebase/10.12.2/firebase-auth-compat.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/firebase/10.12.2/firebase-firestore-compat.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<style>
:root{--brown:#4e2d14;--gold:#c8962e;--bg:#f6f1e7;--line:#e2d8c4;--ink:#2a1a0c}
*{box-sizing:border-box}
body{margin:0;font:16px/1.5 Georgia,serif;background:var(--bg);color:var(--ink)}
header{background:var(--brown);color:#fff;padding:12px 16px;text-align:center;border-bottom:4px solid var(--gold)}
header h1{margin:0;font-size:1.05rem}header .ar{font-size:1.25rem;color:#f0d79a}header small{display:block;color:#e8cf94}
main{max-width:900px;margin:0 auto;padding:14px}
.card{background:#fff;border:1px solid var(--line);border-radius:8px;padding:14px;margin-bottom:14px}
h2{margin:0 0 10px;font-size:1.1rem;color:var(--brown)}
input,select,button{font:inherit;padding:9px;border:1px solid var(--line);border-radius:6px;width:100%;margin-bottom:8px;background:#fff}
button{background:var(--brown);color:#fff;border:0;font-weight:bold;cursor:pointer}
button.alt{background:#fff;color:var(--brown);border:1px solid var(--brown)}
:focus-visible{outline:3px solid var(--gold)}
.row{display:flex;gap:8px}.row>*{flex:1}
.err{color:#9b1c1c;font-size:.9rem}
.tabs{display:flex;flex-wrap:wrap;gap:5px;margin-bottom:12px}
.tabs button{width:auto;flex:1 1 28%;margin:0;padding:9px 4px;font-size:.85rem;background:#fff;color:var(--brown);border:1px solid var(--brown)}
.tabs button.on{background:var(--gold);border-color:var(--gold);color:var(--ink)}
.wrap{overflow-x:auto}
table{border-collapse:collapse;width:100%}
th,td{border:1px solid var(--line);padding:5px 4px;text-align:center;font-size:.88rem}
td:first-child,th:first-child{text-align:left}
td input{width:54px;padding:5px;margin:0;text-align:center}
.g{font-weight:bold;color:var(--brown)}
.hide{display:none}
.rc{background:#fff;border:2px solid var(--brown);padding:12px;margin-bottom:16px;font-size:12px;position:relative}
.rc table{min-width:0}.rc th,.rc td{border:1px solid #444;font-size:11.5px;padding:3px}
.rc h3{margin:0;text-align:center;font-size:15px;color:var(--brown)}
.rc .ar{text-align:center;font-size:19px;color:var(--brown)}
.rc .c{text-align:center}.rc .info{display:flex;flex-wrap:wrap;justify-content:space-between;gap:2px 10px;margin:8px 0;font-weight:bold}
.rc .info span{flex:1 1 45%}
.rc .rem input{border:0;border-bottom:1px solid #444;border-radius:0;padding:2px;margin:0;width:70%;font-style:italic}
.rc .beh td{cursor:pointer;height:20px}.rc .beh td:first-child{cursor:default}
.rc .logo{position:absolute;left:12px;top:10px;width:64px;height:auto}.rc .logo.r{left:auto;right:12px}
.key{font-weight:bold;font-size:11px;line-height:1.8}
@media print{
 header,.tabs,.noprint,#auth,#who{display:none!important}
 body,.card{background:#fff;border:0;padding:0}main{padding:0;max-width:none}
 @page{size:A4 portrait;margin:6mm}
 .rc{--z:1;zoom:var(--z);display:flex;flex-direction:column;height:calc(263mm / var(--z));page-break-after:always;break-inside:avoid;margin:0;border-width:2px;padding:8px}.rc:last-child{page-break-after:auto}
 .rc>table{flex:1 1 auto}
 .rc th,.rc td{line-height:1.2}
 .rc.d1 th,.rc.d1 td{font-size:10.5px;padding:2px}
 .rc.d2 th,.rc.d2 td{font-size:9.5px;padding:1px 2px}
 .rc.d1 .beh td,.rc.d2 .beh td{height:15px}.rc.d2{font-size:10.5px}.rc.d2 .info{margin:4px 0}.rc input{border:0!important}
 .rc th,.rc td{-webkit-print-color-adjust:exact}
}
.abs,.rc td.abs{color:#d40000!important;font-weight:bold;background:#fde8e8;-webkit-print-color-adjust:exact;print-color-adjust:exact}
input.miss{border-color:#d40000!important;background:#fde8e8}
body.lo{background:#f2f0ea}
body.lo header{display:none}
body.lo main{max-width:none;padding:0}
body.lo #auth{min-height:100vh;min-height:100dvh;display:flex;align-items:center;justify-content:center;padding:16px}
.lbox{width:100%;max-width:380px;background:#fff;border:1px solid var(--line);border-top:5px solid var(--gold);border-radius:10px;padding:26px 22px 18px;text-align:center;box-shadow:0 6px 24px rgba(78,45,20,.12)}
.lbox img{width:112px;height:112px;object-fit:contain;display:block;margin:0 auto 8px}
.lbox .ar{font-size:1.15rem;color:var(--brown)}
.lbox .at{font-weight:bold;color:var(--brown);font-size:1rem;margin-top:2px}
.lbox .as{letter-spacing:.12em;font-size:.8rem;margin:4px 0 18px;color:#6b5a3e}
.lbox input{text-align:left}
.lbox .err{min-height:1.2em;margin-bottom:6px}
.lbox .an{font-size:.8rem;color:#6b5a3e;margin:12px 0 4px}
.lbox .af{font-size:.72rem;color:#8a7a5e;margin-top:10px}
.sn{min-width:0!important;width:36px;text-align:center!important;color:#6b5a3e}
#lp{display:none}
body.pl main,body.pl header{display:none!important}
@media print{
 body.pl #lp{display:block;padding:0 4mm}
 #lp .lh{text-align:center;margin-bottom:8px}#lp .lh img{width:56px;height:56px;object-fit:contain}
 #lp .lh .ar{font-size:20px;color:#4e2d14}#lp .lh b{font-size:17px;color:#4e2d14;display:block}
 #lp .lm{margin:6px 0;font-size:13px;display:flex;justify-content:space-between}
 #lp table{width:100%;border-collapse:collapse;font-size:14px}
 #lp th,#lp td{border:1px solid #444;padding:5px 8px;text-align:left}#lp th{background:#f3e9d2;-webkit-print-color-adjust:exact;print-color-adjust:exact}
 #lp td.sn,#lp th.sn{width:44px;text-align:center;color:#000}
 #lp th.b{width:78px;text-align:center;font-size:12px}#lp td{height:22px;padding:2px 8px}
 #lp thead{display:table-header-group}#lp tr{page-break-inside:avoid}
}
.rc .stamp{position:absolute;right:10px;bottom:26px;width:108px;height:auto;opacity:.92;mix-blend-mode:multiply;transform:rotate(-7deg);pointer-events:none;-webkit-print-color-adjust:exact;print-color-adjust:exact}
#pnote{display:none}body.na #pnote{display:block}body.na #printbtn{display:none}
.nt{border:1px solid var(--line);border-left:5px solid var(--gold);border-radius:6px;padding:8px 10px;margin-bottom:10px;font-size:.88rem;line-height:1.45}
.nt .tm{color:#6b5a3e;font-size:.78rem}.nt .pl{margin:6px 0;padding-left:8px;border-left:2px solid var(--line)}.nt button{width:auto;padding:4px 10px;margin:4px 0 0}
@media print{body.na:not(.pl) main{display:none!important}}
</style>
</head>
<body class="lo">
<header>
 <div class="ar">مدرسة أم القرى نسرو اغون</div>
 <h1>UMMUL-QURA SCHOOL NASSARAWA EGGON</h1>
 <small>NO. 2 After Central Mosque Unguwar Danmadami</small>
 <small><i>Motto: Knowledge is light</i></small>
</header>
<main>

<section id="auth">
 <div class="lbox">
  <img id="alogo" alt="School logo">
  <div class="ar">مدرسة أم القرى نسرو اغون</div>
  <div class="at">UMMUL-QURA SCHOOL NASSARAWA EGGON</div>
  <div class="as">SCORE PORTAL</div>
  <input id="email" type="email" placeholder="Email" autocomplete="username">
  <input id="pass" type="password" placeholder="Password" autocomplete="current-password" onkeydown="if(event.key==='Enter')login()">
  <div class="err" id="autherr"></div>
  <button onclick="login()">Log in</button>
  <p class="an">Accounts are created by the school administrator.</p>
  <div class="af">&copy; Ummul-Qura School 2026</div>
 </div>
</section>

<div id="app" class="hide">
 <div class="row noprint" style="align-items:center;margin-bottom:8px">
  <span id="who" style="font-size:.85rem"></span>
  <button id="bell" class="alt hide" style="width:auto;flex:0 0 auto;margin:0 6px 0 0" onclick="tab(6)">&#128276; <span id="bn">0</span></button>
  <button class="alt" style="width:auto;flex:0 0 auto;margin:0" onclick="auth.signOut()">Log out</button>
 </div>
 <div class="tabs noprint">
  <button id="t1" class="on" onclick="tab(1)">Pupils</button>
  <button id="t2" onclick="tab(2)">Scores</button>
  <button id="t3" onclick="tab(3)">Master sheet</button>
  <button id="t4" onclick="tab(4)">Report cards</button>
  <button id="t5" class="hide" onclick="tab(5)">Admin</button>
 </div>

 <section id="p1" class="card">
  <h2>Pupils</h2>
  <select id="cls"></select>
  <input id="q1" type="search" placeholder="Search pupil by full name..." oninput="flt()" autocomplete="off">
  <div id="addbox" class="row hide"><input id="pname" placeholder="Pupil full name"><button style="flex:0 0 90px" onclick="addPupil()">Add</button></div>
  <button class="alt" onclick="printList()">Print class list</button>
  <div id="plist"></div>
 </section>

 <section id="p2" class="card hide">
  <h2>Enter scores</h2><p class="tb g"></p>
  <div class="row"><select id="cls2"></select><select id="sub"></select></div>
  <input id="q2" type="search" placeholder="Search pupil by full name..." oninput="flt()" autocomplete="off">
  <div class="wrap"><table>
   <thead><tr><th class="sn">S/N</th><th>Pupil</th><th>1st /10</th><th>2nd /10</th><th>3rd /10</th><th>Exam /70</th><th>Total</th><th>Grade</th></tr></thead>
   <tbody id="rows"></tbody></table></div>
  <p id="empty" class="err"></p>
 </section>

 <section id="p3" class="card hide">
  <h2>Master sheet</h2><p class="tb g"></p>
  <select id="cls3"></select>
  <input id="q3" type="search" placeholder="Search pupil by full name..." oninput="flt()" autocomplete="off">
  <div class="wrap"><table><thead id="mhead"></thead><tbody id="mrows"></tbody></table></div>
  <p id="empty3" class="err"></p>
 </section>

 <section id="p6" class="card hide">
  <h2>Notifications</h2>
  <p style="font-size:.85rem;margin:0 0 8px">Changes made to scores, behaviour or remarks by other logins.</p>
  <div id="nlist"></div>
  <button class="alt" onclick="readAll()">Mark all as read</button>
 </section>

 <section id="p5" class="card hide">
  <h2>Subjects by section</h2>
  <select id="secsel"><option value="pn">Pre-Nursery &amp; Nursery</option><option value="pr">Primary</option><option value="jss">Junior Secondary (JSS)</option><option value="ss">Senior Secondary (SS)</option></select>
  <div id="sublist"></div>
  <div class="row" style="margin-top:8px"><input id="newsub" placeholder="New subject name"><input id="newar" dir="rtl" placeholder="Arabic name (optional)"></div>
  <button onclick="addSub()">Add subject</button>
  <button class="alt" onclick="resetSubs()">Reset this section to default</button>
  <h2 style="margin-top:18px">End of session</h2>
  <p style="font-size:.9rem">Moves every pupil to the next class (Pre-Nursery to Nursery 1, Primary 6 to JSS 1, JSS 3 to SS 1, SS 3 to Graduated) and starts the next session at First Term. Do this once, after the Third Term results are printed.</p>
  <button onclick="promote()">Promote all pupils</button>
  <h2 style="margin-top:18px">Backup</h2>
  <p style="font-size:.9rem">Download all pupils and scores as an Excel file. Keep a copy at the end of every term.</p>
  <button class="alt" onclick="backup()">Download Excel backup</button>
 </section>

 <section id="p4" class="hide">
  <div class="card noprint">
   <h2>Report cards</h2>
   <div class="row"><select id="cls4"></select><select id="pick"></select></div>
   <input id="q4" type="search" placeholder="Search pupil by full name..." oninput="flt()" autocomplete="off">
   <div class="row">
    <input id="ses" placeholder="Session e.g. 2026/2027">
    <select id="trm"><option>FIRST TERM</option><option>SECOND TERM</option><option>THIRD TERM</option></select>
   </div>
   <div class="row"><label>Term ending<input id="end" type="date"></label><label>Next term begins<input id="nxt" type="date"></label></div>
   <input id="tel" type="tel" placeholder="School phone number (change each term)">
   <button id="printbtn" onclick="doPrint()">Print</button>
   <p id="pnote" class="err">Only the administrator can print result sheets.</p>
   <p class="err" id="empty4"></p>
  </div>
  <div id="cards"></div>
 </section>
</div>
</main>
<div id="lp"></div>

<script>
firebase.initializeApp({
  apiKey: "AIzaSyBXi7SyHdHDqPci1itFC4c2eA6tt8ue-ZI",
  authDomain: "ummul-qura-school-portal.firebaseapp.com",
  projectId: "ummul-qura-school-portal",
  storageBucket: "ummul-qura-school-portal.firebasestorage.app",
  messagingSenderId: "615412641062",
  appId: "1:615412641062:web:ca3d153b923e9c747265e7"
});
const auth=firebase.auth(),db=firebase.firestore(),FP=firebase.firestore.FieldPath;
auth.setPersistence(firebase.auth.Auth.Persistence.SESSION).catch(()=>{});
const $=id=>document.getElementById(id);
const LOGO="data:image/jpeg;base64,";
$("alogo").src=LOGO;
const STAMP="data:image/svg+xml;base64,";
const STAMP_P="data:image/svg+xml;base64,"+btoa(atob(STAMP.split(",")[1]).replace("OFFICE OF THE HEADMASTER","OFFICE OF THE PRINCIPAL"));
const stampFor=c=>/^(JSS|SS)/.test(c)?STAMP_P:STAMP;
const esc=s=>String(s).replace(/[&<>"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
const CLASSES=["Pre-Nursery","Nursery 1","Nursery 2","Primary 1","Primary 2","Primary 3","Primary 4","Primary 5","Primary 6","JSS 1","JSS 2","JSS 3","SS 1","SS 2","SS 3"];
const Q=["Glorious Qur'an","القرآن الكريم"],IS=["Islamiyyat","الإسلاميات"],AR=["Arabic Language","اللغة العربية"],EN=["English","اللغة الإنجليزية"],MA=["Mathematics","الرياضيات"],CV=["Civic Education","التربية المدنية"],CS=["Computer Studies","الحاسوب"],AG=["Agricultural Science","العلوم الزراعية"],HA=["Hausa","اللغة الهوسا"];
const PN=[Q,IS,AR,CV,["Letter Work","عمل الحروف"],["Number Work","عمل الأرقام"],["Basic Science & Tech","العلوم الأساسية"],["Health Habit","العادة الصحية"]];
const PR=[["Glorious Qur'an","القرآن الكريم"],["Islamiyyat","الإسلاميات"],["Arabic Language","اللغة العربية"],["English","اللغة الإنجليزية"],["Mathematics","الرياضيات"],["Basic Science & Tech","العلوم الأساسية"],["Social Studies","الدراسات الاجتماعية"],["Civic Education","التربية المدنية"],["Hausa","اللغة الهوسا"],["Computer Studies","الحاسوب"],["Agricultural Science","العلوم الزراعية"]];
const JS=[Q,IS,AR,EN,MA,["Basic Science","العلوم الأساسية"],["Basic Technology","التقنية الأساسية"],["Social Studies","الدراسات الاجتماعية"],CV,CS,AG,["Business Studies","الدراسات التجارية"],["Home Economics","الاقتصاد المنزلي"],HA,["Physical & Health Education","التربية البدنية والصحية"],["Cultural & Creative Arts","الفنون الثقافية والإبداعية"]];
const SS=[Q,IS,AR,EN,MA,["Further Mathematics","الرياضيات المتقدمة"],["Physics","الفيزياء"],["Chemistry","الكيمياء"],["Biology","الأحياء"],["Economics","الاقتصاد"],["Government","الحكومة"],["Literature in English","الأدب الإنجليزي"],["Geography","الجغرافيا"],["Commerce","التجارة"],["Financial Accounting","المحاسبة"],CV,CS,["Data Processing","معالجة البيانات"],AG,HA];
let SUBJ=PN;
const DEFS={pn:PN,pr:PR,jss:JS,ss:SS};let SUBS={};
const secOf=c=>/^(Pre|Nursery)/.test(c)?"pn":/^Primary/.test(c)?"pr":/^JSS/.test(c)?"jss":"ss";
const defObjs=k=>DEFS[k].map(([n,ar])=>({k:n,n,ar}));
const subjFor=c=>{const k=secOf(c);return(SUBS[k]||defObjs(k)).map(x=>[x.k,x.ar||"",x.n])};
const setSub=()=>{const v=$("sub").value,L=subjFor($("cls2").value);$("sub").innerHTML=L.map(x=>`<option value="${esc(x[0])}">${esc(x[2])}</option>`).join("");if(L.some(x=>x[0]===v))$("sub").value=v};
const T=[["t1",10],["t2",10],["t3",10],["ex",70]];
const BEH=["Punctuality","Attendance in class","Attentiveness in class","Carrying out Assignment","Participation in Class Activities","Neatness","Self Control","Relationship with others","Games/Sports","Handling of Lab. Tools/Workshop"];
const RATE=["Excellent","V. Good","Good","Fair","Poor"];
const fill=(el,a)=>el.innerHTML=a.map(x=>`<option>${x}</option>`).join("");
["cls","cls2","cls3","cls4"].forEach(i=>fill($(i),CLASSES));setSub();
const grade=t=>t>=70?"A":t>=60?"B":t>=50?"C":t>=40?"D":"E";
const has=s=>s&&T.some(([k])=>s[k]!=null);
const tot=s=>s?T.reduce((a,[k])=>a+(+s[k]||0),0):0;
const ord=n=>n+(["th","st","nd","rd"][(n%100>10&&n%100<14)?0:(n%10<4?n%10:0)]);
const fmt=d=>{if(!d)return"";const x=new Date(d+"T00:00");return`${ord(x.getDate())} ${x.toLocaleString("en",{month:"short"})}, ${x.getFullYear()}`};
let ADMIN=false;
const TN=()=>({"FIRST TERM":1,"SECOND TERM":2,"THIRD TERM":3}[S.trm]||1);
const TK=n=>S.ses.replace(/\//g,"-")+"_"+(n||TN());
const cur=(p,n)=>(p.sc||{})[TK(n)]||{};
const termRes=(p,n)=>{const r=(p.res||{})[TK(n)];if(n!==TN()&&r)return r;const c=cur(p,n),L=subjFor(p.class).filter(([k])=>has(c[k]));if(!L.length)return r||null;const t=L.reduce((a,[k])=>a+tot(c[k]),0);return{t,a:t/L.length}};
const ann=p=>{const a=[1,2,3].map(n=>termRes(p,n)).filter(Boolean);return a.length?Math.round(a.reduce((x,r)=>x+r.a,0)/a.length):""};
let PC=[];
const ttl=(p,n)=>{const c=cur(p,n);return subjFor(p.class).some(([k])=>has(c[k]))?subjFor(p.class).reduce((a,[k])=>a+tot(c[k]),0):""};
const msg=e=>({"auth/invalid-credential":"Wrong email or password.","auth/email-already-in-use":"This email already has an account. Log in instead.","auth/weak-password":"Use a password with at least 6 characters.","auth/invalid-email":"Enter a valid email address."}[e.code]||e.message);

function login(){auth.signInWithEmailAndPassword($("email").value.trim(),$("pass").value).catch(e=>$("autherr").textContent=msg(e))}
let S={ses:"2026/2027",trm:"FIRST TERM",end:"",nxt:"",tel:""};
auth.onAuthStateChanged(async u=>{
 $("auth").classList.toggle("hide",!!u);$("app").classList.toggle("hide",!u);document.body.classList.toggle("lo",!u);
 if(!u){if(unsub){unsub();unsub=null}ADMIN=false;return}$("who").textContent=u.email;
 try{const d=await db.doc("settings/term").get();if(d.exists)S={...S,...d.data()}}catch(e){}
 try{ADMIN=(await db.doc("admins/"+u.uid).get()).exists}catch(e){ADMIN=false}
 $("addbox").classList.toggle("hide",!ADMIN);$("t5").classList.toggle("hide",!ADMIN);document.body.classList.toggle("na",!ADMIN);$("bell").classList.toggle("hide",!ADMIN);if(ADMIN)watchNotifs();
 try{const d2=await db.doc("settings/subjects").get();if(d2.exists)SUBS=d2.data()}catch(e){}
 setSub();
 ["ses","trm","end","nxt","tel"].forEach(k=>$(k).disabled=!ADMIN);
 $("ses").value=S.ses;$("trm").value=S.trm;$("end").value=S.end;$("nxt").value=S.nxt;$("tel").value=S.tel||"";banner();
 loadPupils();
});
["ses","trm","end","nxt","tel"].forEach(k=>$(k).onchange=()=>{S[k]=$(k).value;db.doc("settings/term").set(S).catch(e=>alert("Could not save: "+e.message));banner();loadCards(true)});

function banner(){document.querySelectorAll(".tb").forEach(e=>e.textContent=S.ses+" · "+S.trm)}
function tab(n){banner();
 for(let i=1;i<=6;i++){$("p"+i).classList.toggle("hide",i!==n);const t=$("t"+i);if(t)t.classList.toggle("on",i===n)}if(n===6)renderN();
 if(n===1)loadPupils();if(n===2)loadScores();if(n===3)loadMaster();if(n===4)loadCards(true);if(n===5)loadSubjects();
}
async function pupils(c){SUBJ=subjFor(c);
 const s=await db.collection("pupils").where("class","==",c).get();
 const L=s.docs.map(d=>({id:d.id,...d.data()})).sort((a,b)=>a.name.localeCompare(b.name));
 L.forEach(p=>{let t=0,n=0;SUBJ.forEach(([k])=>{const x=cur(p)[k];if(has(x)){t+=tot(x);n++}});p.total=t;p.n=n;p.avg=n?t/n:0});
 L.forEach((p,i)=>p.sn=i+1);
 L.forEach(p=>p.pos=1+L.filter(q=>q.total>p.total).length);
 return L;
}
const nk=x=>x.toLowerCase().replace(/\s+/g," ").trim();
async function dup(name,cls,skip){const L=await pupils(cls);return L.find(p=>p.id!==skip&&nk(p.name)===nk(name))}
const dupMsg=(n,c)=>`"${n}" already exists in ${c}. If this is a different pupil, add a middle name or initial to tell them apart.`;
async function addPupil(){
 const name=$("pname").value.trim().replace(/\s+/g," ");if(!name)return;
 const c=$("cls").value;
 if(await dup(name,c))return alert(dupMsg(name,c));
 await db.collection("pupils").add({name,class:c,scores:{},by:auth.currentUser.uid});
 $("pname").value="";loadPupils();
}
async function loadPupils(){
 const L=await pupils($("cls").value);
 $("plist").innerHTML=L.length?L.map((p,i)=>`<div class="row" style="align-items:center"><span>${i+1}. ${esc(p.name)}</span>${ADMIN?`<button class="alt" style="flex:0 0 auto;width:auto;margin:2px;padding:4px 10px" onclick="ren('${p.id}')">Edit</button><button class="alt" style="flex:0 0 auto;width:auto;margin:2px;padding:4px 10px" onclick="del('${p.id}')">Delete</button><button class="alt" style="flex:0 0 auto;width:auto;margin:2px;padding:4px 10px" onclick="mv('${p.id}')">Move</button>`:""}</div>`).join(""):'<p class="err">No pupils in this class yet. Add the first one above.</p>';
}
$("cls").onchange=loadPupils;$("cls2").onchange=()=>{setSub();loadScores()};$("sub").onchange=loadScores;$("cls3").onchange=loadMaster;$("cls4").onchange=()=>{$("pick").value="";loadCards(true)};$("pick").onchange=loadCards;

async function loadScores(){
 const L=await pupils($("cls2").value),sub=$("sub").value;PC=L;
 $("empty").textContent=L.length?"":"No pupils in this class yet. Add them in the Pupils tab.";
 $("rows").innerHTML=L.map(p=>{const sc=cur(p)[sub]||{};
  return`<tr id="r${p.id}"><td class="sn">${p.sn}</td><td style="text-align:left;min-width:120px">${esc(p.name)}</td>`+T.map(([k,m])=>`<td><input type="number" inputmode="numeric" min="1" max="${m}" value="${sc[k]??""}" data-id="${p.id}" data-k="${k}" data-m="${m}" data-old="${sc[k]??""}" onchange="save(this)"></td>`).join("")+`<td class="tot"></td><td class="g"></td></tr>`}).join("");
 L.forEach(p=>calc(p.id));
}
function calc(id){
 const r=$("r"+id);let t=0,a=false;
 r.querySelectorAll("input").forEach(i=>{if(i.value!==""){t+=+i.value;a=true}});
 r.querySelectorAll("input").forEach(i=>i.classList.toggle("miss",a&&i.value===""&&i.dataset.k!=="ex"));
 r.querySelector(".tot").textContent=a?t:"";r.querySelector(".g").textContent=a?grade(t):"";
}
async function save(i){
 const m=+i.dataset.m;let v=i.value===""?null:+i.value;
 if(v!==null&&!(v>=1)){alert("Invalid score. The minimum score is 1. Leave the box blank for an absent pupil.");i.value=i.dataset.old;calc(i.dataset.id);return}
 if(v!==null)v=Math.min(m,v);
 i.value=v===null?"":v;i.dataset.old=i.value;calc(i.dataset.id);
 try{await db.collection("pupils").doc(i.dataset.id).update(new FP("sc",TK(),$("sub").value,i.dataset.k),v);i.style.borderColor="#2e7d32";
  const p=PC.find(x=>x.id===i.dataset.id);
  if(p){const sb=$("sub").value,tk=TK();p.sc=p.sc||{};p.sc[tk]=p.sc[tk]||{};const bef={...(p.sc[tk][sb]||{})};p.sc[tk][sb]={...bef,[i.dataset.k]:v};
   if((bef[i.dataset.k]??null)!==v)logN({kind:"sc",pid:p.id,pname:p.name,cls:p.class,subk:sb,subn:(subjFor(p.class).find(x=>x[0]===sb)||[])[2]||sb,term:tk,f:i.dataset.k,bef,aft:{...p.sc[tk][sb]}});
   const c=p.sc[tk],L=subjFor(p.class).filter(([k])=>has(c[k])),t=L.reduce((a,[k])=>a+tot(c[k]),0),r={t,a:L.length?t/L.length:0,n:L.length,c:p.class};
   p.res=p.res||{};p.res[tk]=r;await db.collection("pupils").doc(p.id).update(new FP("res",tk),r)}}
 catch(e){i.style.borderColor="#9b1c1c";alert("Could not save: "+e.message)}
}

async function loadMaster(){
 const L=(await pupils($("cls3").value)).sort((a,b)=>a.pos-b.pos||a.name.localeCompare(b.name));
 $("empty3").textContent=L.length?"":"No pupils in this class yet.";
 $("mhead").innerHTML="<tr><th class=\"sn\">S/N</th><th>Pupil</th>"+subjFor($("cls3").value).map(s=>`<th>${esc(s[2])}</th>`).join("")+"<th>Total</th><th>Avg</th><th>Pos</th></tr>";
 $("mrows").innerHTML=L.map(p=>`<tr><td class="sn">${p.sn}</td><td style="text-align:left;min-width:120px">${esc(p.name)}</td>`+SUBJ.map(([k])=>{const x=cur(p)[k];return`<td>${has(x)?tot(x):""}</td>`}).join("")+`<td class="g">${p.n?p.total:""}</td><td>${p.n?Math.round(p.avg):""}</td><td>${p.n?ord(p.pos):""}</td></tr>`).join("");
}

let CL=[];
async function loadCards(reload){
 if(reload===true||!CL.length||CL._c!==$("cls4").value){CL=await pupils($("cls4").value);CL._c=$("cls4").value;
  $("pick").innerHTML="<option value=''>Whole class</option>"+CL.map(p=>`<option value="${p.id}">${esc(p.name)}</option>`).join("")}
 $("empty4").textContent=CL.length?"":"No pupils in this class yet.";
 const sel=$("pick").value,list=sel?CL.filter(p=>p.id===sel):CL;
 $("cards").innerHTML=list.map(card).join("");
}
const REM={A:["An excellent result, keep it up.","A very satisfactory result, keep it up."],B:["A very good result, keep it up.","A good result, keep working hard."],C:["A good result, you can do better.","A fair result, put in more effort."],D:["A fair result, work harder.","An average result, you must improve."],E:["A poor result, you must improve.","A weak result, serious effort is needed."]};
function card(p){
 const g=grade(p.avg),b=(p.bh||{})[TK()]||{};
 const rows=(/^SS/.test(p.class)&&p.n?subjFor(p.class).filter(([k])=>has(cur(p)[k])):subjFor(p.class)).map(([k,ar,nm])=>{const x=cur(p)[k],t=tot(x),h=has(x);
  return`<tr><td style="text-align:left"><b>${esc(nm)}</b></td>${T.map(([f])=>`<td${h&&x[f]==null&&f!=="ex"?' class="abs"':""}>${h?(x[f]!=null?x[f]:"ABS"):""}</td>`).join("")}<td><b>${h?t:""}</b></td><td>${h?grade(t):""}</td><td>${ar}</td></tr>`}).join("");
 const cnt=(rows.match(/<tr>/g)||[]).length;
 const beh=BEH.map((n,i)=>[1,2].includes(i)?"":`<tr class="beh"><td style="text-align:left">${n}</td>${RATE.map((_,j)=>`<td id="b${p.id}_${i}_${j}" onclick="rate('${p.id}',${i},${j})">${b[i]===j?"✓":""}</td>`).join("")}</tr>`).join("");
 const ZT=[1.39,1.39,1.39,1.35,1.32,1.3,1.27,1.27,1.24,1.2,1.17,1.14,1.11];
 return`<div class="rc ${cnt>16?"d2":cnt>12?"d1":""}" style="--z:${cnt>12?1:ZT[cnt]}" data-name="${esc(p.name)}"><img class="logo" src="${LOGO}" alt=""><img class="logo r" src="${LOGO}" alt=""><img class="stamp" src="${stampFor(p.class)}" alt="">
 <div class="ar">مدرسة أم القرى نسرو اغون</div><h3>UMMUL-QURA SCHOOL NASSARAWA EGGON</h3>
 <div class="c">NO. 2 After Central Mosque Unguwar Danmadami</div><div class="c"><i>Motto: Knowledge is light</i></div>
 <div class="c">${S.tel?"Tel: "+esc(S.tel)+" &nbsp; ":""}E-mail: ummulqura@gmail.com</div>
 <div class="c" style="margin-top:6px;border-top:2px solid var(--brown);padding-top:4px"><b>${esc(S.ses)} RESULT (${esc(S.trm)})</b></div>
 <div class="info"><span>Name: ${esc(p.name)}</span><span>Position: ${p.n?ord(p.pos):""}</span><span>Class: ${p.class.toUpperCase()}</span><span>No in Class: ${CL.length}</span><span>Term Ending: ${fmt(S.end)}</span><span>Next Term Begins: ${fmt(S.nxt)}</span></div>
 <table><tr><th rowspan="2">SUBJECTS</th><th colspan="3">TEST</th><th>Exam</th><th>Total</th><th rowspan="2">Grade</th><th rowspan="2">المواد</th></tr><tr><th>10</th><th>10</th><th>10</th><th>70</th><th>100</th></tr>${rows}
 <tr><td colspan="8" style="text-align:left">${[1,2,3].map(n=>{const r=termRes(p,n);return`${ord(n)} Term: <b>${r?r.t+" (Avg "+Math.round(r.a)+")":""}</b>`}).join(" &nbsp; ")}<br><b>Total: ${p.n?p.total:""}</b> &nbsp;&nbsp;&nbsp; <b>Average: ${p.n?Math.round(p.avg):""}</b>${TN()===3&&ann(p)!==""?` &nbsp;&nbsp;&nbsp; <b>Annual Average: ${ann(p)}</b>`:""}</td></tr></table>
 <div class="row" style="margin-top:8px;gap:8px;align-items:flex-start"><table class="beh" style="flex:3"><tr><th style="text-align:left">BEHAVIOUR</th>${RATE.map(r=>`<th>${r}</th>`).join("")}</tr>${beh}</table>
 <div class="key" style="flex:1">KEY TO RATE<br>A = EXCELLENT<br>B = V. GOOD<br>C = GOOD<br>D = FAIR<br>E = POOR</div></div>
 <div class="rem" style="margin-top:8px">Form Master's Remark: <input value="${esc((p.fr||{})[TK()]??REM[g][0])}" onchange="rem('${p.id}','fr',this.value)"><br>
 ${/^(JSS|SS)/.test(p.class)?"Principal":"Headmaster"}'s Remark: <input value="${esc((p.hr||{})[TK()]??REM[g][1])}" onchange="rem('${p.id}','hr',this.value)"></div>
 <div style="font-size:10px;margin-top:6px;padding-right:118px">Dear parents/guardians, above is the statement of result of your child/ward for ${esc(S.trm.toLowerCase())} examination ${esc(S.ses)} session. Please help your child to improve in his/her weak subjects.</div></div>`;
}
async function rate(id,i,j){
 const p=CL.find(x=>x.id===id),k0=TK();p.bh=p.bh||{};p.bh[k0]=p.bh[k0]||{};p.bh[k0][i]=p.bh[k0][i]===j?null:j;
 RATE.forEach((_,k)=>$(`b${id}_${i}_${k}`).textContent=p.bh[k0][i]===k?"✓":"");
 try{await db.collection("pupils").doc(id).update(new FP("bh",k0,String(i)),p.bh[k0][i]);logN({kind:"beh",pid:id,pname:p.name,cls:p.class,term:k0})}catch(e){alert("Could not save: "+e.message)}
}
async function rem(id,k,v){
 const p=CL.find(x=>x.id===id);p[k]=p[k]||{};p[k][TK()]=v;
 try{await db.collection("pupils").doc(id).update(new FP(k,TK()),v);logN({kind:"beh",pid:id,pname:p.name,cls:p.class,term:TK()})}catch(e){alert("Could not save: "+e.message)}
}
const secList=()=>{const k=$("secsel").value;return(SUBS[k]||defObjs(k)).map(x=>({...x}))};
function loadSubjects(){
 const b='class="alt" style="flex:0 0 auto;width:auto;margin:2px;padding:4px 10px"';
 $("sublist").innerHTML=secList().map((x,i)=>`<div class="row" style="align-items:center"><span>${i+1}. ${esc(x.n)} <span dir="rtl">${esc(x.ar||"")}</span></span><button ${b} onclick="editSub(${i})">Edit</button><button ${b} onclick="delSub(${i})">Remove</button></div>`).join("");
}
let NOTIFS=[],GR=[],unsub=null;
const ms=d=>d.ts&&d.ts.toMillis?d.ts.toMillis():Date.now();
function logN(o){if(ADMIN||!auth.currentUser)return;db.collection("notifs").add({uid:auth.currentUser.uid,by:auth.currentUser.email,ts:firebase.firestore.FieldValue.serverTimestamp(),read:false,...o}).catch(()=>{})}
function watchNotifs(){
 if(unsub||!ADMIN)return;
 unsub=db.collection("notifs").where("read","==",false).limit(500).onSnapshot(q=>{NOTIFS=q.docs.map(d=>({id:d.id,...d.data()}));GR=groups();$("bn").textContent=GR.length;renderN()},e=>console.log(e.message))
}
function groups(){
 const G={};NOTIFS.forEach(d=>{const k=[d.uid,d.cls,d.kind,d.subk||"",d.term].join("|");(G[k]=G[k]||[]).push(d)});
 return Object.values(G).map(a=>a.sort((x,y)=>ms(x)-ms(y))).sort((x,y)=>ms(y[y.length-1])-ms(x[x.length-1]));
}
const LAB={t1:"1st CA",t2:"2nd CA",t3:"Assignment",ex:"Exam"};
const mk=o=>T.map(([k])=>`${LAB[k]} ${o&&o[k]!=null?o[k]:"–"}`).join(", ")+` (Total ${tot(o||{})})`;
function renderN(){
 if(!$("nlist"))return;
 GR=groups();
 $("nlist").innerHTML=GR.length?GR.map((a,gi)=>{
  const f=a[0],l=a[a.length-1],P={},tl=f.term.split("_"),when=new Date(ms(l)).toLocaleString();
  const head=`<b>${esc(f.by)}</b> ${f.kind==="sc"?"changed scores":"changed behaviour/remarks"}<br>${esc(f.cls)}${f.kind==="sc"?" · "+esc(f.subn):""} · ${esc(tl[0].replace("-","/"))} term ${esc(tl[1])}<div class="tm">${when}</div>`;
  a.forEach(d=>{const x=P[d.pid]=P[d.pid]||{name:d.pname,bef:d.bef,aft:d.aft};x.aft=d.aft});
  let ids=Object.keys(P);
  if(f.kind==="sc")ids=ids.filter(i=>JSON.stringify(T.map(([k])=>(P[i].bef||{})[k]??null))!==JSON.stringify(T.map(([k])=>(P[i].aft||{})[k]??null)));
  const body=ids.length>2?`<div class="pl">${ids.length} pupils were affected.</div>`:ids.map(i=>f.kind==="sc"?`<div class="pl"><b>${esc(P[i].name)}</b><br>Initial: ${mk(P[i].bef)}<br>Now: ${mk(P[i].aft)}</div>`:`<div class="pl"><b>${esc(P[i].name)}</b></div>`).join("");
  return`<div class="nt">${head}${body}<button class="alt" onclick="readG(${gi})">Mark as read</button></div>`}).join(""):"<p>No new notifications.</p>";
}
async function readDocs(L){let b=db.batch(),c=0;for(const d of L){b.update(db.collection("notifs").doc(d.id),{read:true});if(++c===400){await b.commit();b=db.batch();c=0}}if(c)await b.commit()}
function readG(i){readDocs(GR[i]).catch(e=>alert(e.message))}
function readAll(){readDocs(NOTIFS).catch(e=>alert(e.message))}
function doPrint(){if(!ADMIN)return alert("Only the administrator can print result sheets.");window.print()}
async function saveSubs(L){const k=$("secsel").value;SUBS[k]=L;try{await db.doc("settings/subjects").set({[k]:L},{merge:true})}catch(e){alert("Could not save: "+e.message)}loadSubjects();setSub()}
function addSub(){const n=$("newsub").value.trim();if(!n)return;const L=secList();L.push({k:"s"+Date.now().toString(36),n,ar:$("newar").value.trim()});$("newsub").value=$("newar").value="";saveSubs(L)}
function editSub(i){const L=secList(),n=prompt("Subject name:",L[i].n);if(!n||!n.trim())return;const a=prompt("Arabic name (optional):",L[i].ar||"");L[i].n=n.trim();L[i].ar=(a||"").trim();saveSubs(L)}
function delSub(i){const L=secList();if(confirm(`Remove "${L[i].n}" from this section? Scores already entered stay saved but will no longer show.`)){L.splice(i,1);saveSubs(L)}}
function resetSubs(){if(!confirm("Reset this section's subjects to the defaults?"))return;const k=$("secsel").value;delete SUBS[k];db.doc("settings/subjects").set({[k]:firebase.firestore.FieldValue.delete()},{merge:true}).then(()=>{loadSubjects();setSub()}).catch(e=>alert(e.message))}
$("secsel").onchange=loadSubjects;
const nextClass=c=>{const i=CLASSES.indexOf(c);return i<0?c:i===CLASSES.length-1?"Graduated":CLASSES[i+1]};
const nextSes=x=>{const m=x.match(/(\d{4})\s*\/\s*(\d{4})/);return m?`${+m[1]+1}/${+m[2]+1}`:x};
async function promote(){
 if(!ADMIN)return;
 if(S.promoted===S.ses&&!confirm("Pupils were already promoted for "+S.ses+". Promote again?"))return;
 if(S.trm!=="THIRD TERM"&&!confirm("The current term is "+S.trm+", not THIRD TERM. Promote anyway?"))return;
 if(!confirm("Promote ALL pupils to the next class and start the new session? SS 3 pupils are marked Graduated. Scores of this session stay saved."))return;
 try{
  const q=await db.collection("pupils").get();let b=db.batch(),n=0,c=0;
  for(const d of q.docs){const nc=nextClass(d.data().class);if(nc===d.data().class)continue;b.update(d.ref,{class:nc});n++;c++;if(c===400){await b.commit();b=db.batch();c=0}}
  if(c)await b.commit();
  S={...S,promoted:S.ses,ses:nextSes(S.ses),trm:"FIRST TERM",end:"",nxt:""};
  await db.doc("settings/term").set(S);
  $("ses").value=S.ses;$("trm").value=S.trm;$("end").value="";$("nxt").value="";banner();
  alert(n+" pupils promoted. New session: "+S.ses+" (FIRST TERM). Now set the new term dates in Report cards.")
 }catch(e){alert("Could not promote: "+e.message)}
}
async function mv(id){
 const c=prompt("Move to which class? Type exactly one of:\n"+CLASSES.join(", "));if(!c)return;
 const nc=c.trim();if(!CLASSES.includes(nc))return alert("Class not recognised.");
 const d=await db.collection("pupils").doc(id).get(),nm=d.data().name;
 if(await dup(nm,nc,id))return alert(dupMsg(nm,nc));
 db.collection("pupils").doc(id).update({class:nc}).then(loadPupils).catch(e=>alert(e.message))
}
async function backup(){
 if(!window.XLSX)return alert("The Excel tool did not load. Check your internet and try again.");
 try{
  const NM={};["pn","pr","jss","ss"].forEach(k=>(SUBS[k]||defObjs(k)).forEach(x=>NM[x.k]=x.n));
  const q=await db.collection("pupils").get(),P=[],A=[],R=[];
  q.docs.forEach(d=>{const p=d.data();P.push({Pupil:p.name,Class:p.class});
   Object.entries(p.sc||{}).forEach(([tk,subs])=>{const[ses,tn]=tk.split("_");Object.entries(subs).forEach(([k,x])=>{if(!has(x))return;const v=f=>x[f]!=null?x[f]:"ABS";A.push({Session:ses.replace("-","/"),Term:tn,Class:p.class,Pupil:p.name,Subject:NM[k]||k,"1st Test":v("t1"),"2nd Test":v("t2"),Assignment:v("t3"),Exam:v("ex"),Total:tot(x),Grade:grade(tot(x))})})});
   Object.entries(p.res||{}).forEach(([tk,r])=>{const[ses,tn]=tk.split("_");R.push({Session:ses.replace("-","/"),Term:tn,Class:r.c||p.class,Pupil:p.name,"Term Total":r.t,"Term Average":Math.round(r.a*10)/10})})});
  const by=(a,b)=>String(a.Class).localeCompare(b.Class)||String(a.Pupil).localeCompare(b.Pupil);
  P.sort(by);A.sort(by);R.sort(by);
  const wb=XLSX.utils.book_new();
  XLSX.utils.book_append_sheet(wb,XLSX.utils.json_to_sheet(P),"Pupils");
  XLSX.utils.book_append_sheet(wb,XLSX.utils.json_to_sheet(A),"Scores");
  XLSX.utils.book_append_sheet(wb,XLSX.utils.json_to_sheet(R),"Term results");
  XLSX.writeFile(wb,"Ummul-Qura-backup-"+new Date().toISOString().slice(0,10)+".xlsx");
 }catch(e){alert("Backup failed: "+e.message)}
}
function flt(){
 const f=(els,get,q)=>{const w=q.trim().toLowerCase().split(/\s+/).filter(Boolean);els.forEach(e=>{const t=get(e).toLowerCase();e.style.display=w.every(x=>t.includes(x))?"":"none"})};
 f([...$("plist").children],e=>(e.querySelector("span")||e).textContent,$("q1").value);
 f([...$("rows").rows],e=>e.cells[1].textContent,$("q2").value);
 f([...$("mrows").rows],e=>e.cells[1].textContent,$("q3").value);
 f([...$("cards").children],e=>e.dataset.name||"",$("q4").value);
}
["plist","rows","mrows","cards"].forEach(id=>new MutationObserver(flt).observe($(id),{childList:true}));
async function printList(){
 const c=$("cls").value,L=await pupils(c);
 if(!L.length)return alert("There are no pupils in "+c+" yet.");
 $("lp").innerHTML=`<div class="lh"><img src="${LOGO}" alt=""><div class="ar">مدرسة أم القرى نسرو اغون</div><b>UMMUL-QURA SCHOOL NASSARAWA EGGON</b><div>CLASS LIST AND SCORE SHEET</div></div>
 <div class="lm"><span>Class: <b>${esc(c)}</b></span><span>Session: <b>${esc(S.ses)}</b></span><span>Total pupils: <b>${L.length}</b></span></div>
 <div class="lm" style="margin-top:0"><span>Subject: ______________________</span><span>Teacher: ______________________</span><span>Date: ____________</span></div>
 <table><thead><tr><th class="sn">S/N</th><th>Full name</th><th class="b">1st CA<br>/10</th><th class="b">2nd CA<br>/10</th><th class="b">Assignment<br>/10</th><th class="b">Exam<br>/70</th></tr></thead><tbody>${L.map(p=>`<tr><td class="sn">${p.sn}</td><td>${esc(p.name)}</td><td></td><td></td><td></td><td></td></tr>`).join("")}</tbody></table>`;
 document.body.classList.add("pl");window.print();
}
addEventListener("afterprint",()=>document.body.classList.remove("pl"));
async function ren(id){
 const n=prompt("Pupil name:");if(!n||!n.trim())return;const nm=n.trim().replace(/\s+/g," ");
 const d=await db.collection("pupils").doc(id).get(),c=d.data().class;
 if(await dup(nm,c,id))return alert(dupMsg(nm,c));
 db.collection("pupils").doc(id).update({name:nm}).then(loadPupils).catch(e=>alert(e.message))
}
async function del(id){if(confirm("Delete this pupil and all scores? This cannot be undone."))db.collection("pupils").doc(id).delete().then(loadPupils).catch(e=>alert(e.message))}
</script>
</body>
</html>
